[
  {"id": "ts-fr-01", "category": "TS", "language": "fr", "user": "Donne-moi l'état de la machine.",
   "expect": {"tools": ["get_machine_state"]}},
  {"id": "ts-fr-02", "category": "TS", "language": "fr", "user": "Où est la machine en ce moment ?",
   "expect": {"tools": ["get_machine_state"]}},
  {"id": "ts-fr-03", "category": "TS", "language": "fr", "user": "Fais l'origine de tous les axes.",
